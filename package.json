{
  "name": "goofyfish",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build && cp build/client/404/index.html build/client/404.html && node scripts/pack-skill.mjs build/client",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "preview": "pnpm dlx sirv-cli build/client --dev --port 4173",
    "game:check": "node scripts/check-game.mjs",
    "game:thumb": "node scripts/make-thumb.mjs"
  },
  "dependencies": {
    "isbot": "^5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@react-router/dev": "^8.5.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "playwright": "^1.65.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3"
  }
}
