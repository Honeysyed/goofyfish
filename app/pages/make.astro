---
import Logo from '~/components/Logo.astro';
import Base from '~/layouts/Base.astro';
import { SITE } from '~/lib/site';

const PROMPT = 'a game where you keep a balloon in the air';
const FIGURES = [
  { id: 'classic', name: 'Classic', prompt: '' },
  { id: 'doodle', name: 'Doodle', prompt: ', doodle style' },
  { id: 'doodleshirt', name: 'Doodle shirt', prompt: ', doodle shirt style' },
  { id: 'sketch', name: 'Sketch', prompt: ', sketch style' },
  { id: 'chunky', name: 'Chunky', prompt: ', chunky style' },
  { id: 'googly', name: 'Googly', prompt: ', googly style' },
];
const CLONE = `git clone ${SITE.github}\ncd goofyfish && pnpm install`;

const steps = [
  { title: 'Get the code', code: CLONE },
  { title: 'Ask for a game', text: 'Pick a figure, then open Claude Code in the folder, type /game and describe your idea.', terminal: true },
  { title: 'Play and tweak', text: 'It builds the game, tests it and draws the thumbnail. Play it and ask for changes.' },
  { title: 'Send it in', text: 'Say the word and it walks you through the pull request. We play it and put it on the site.' },
];

---

<Base
  title={`Make your own game · ${SITE.name}`}
  description='Describe a game to Claude Code. It builds it in the goofyfish style and sends it in as a pull request.'
  path='/make'
>
  <main class='mx-auto max-w-[640px] px-5 pt-10 pb-24 sm:pt-14'>
    <a href='/' class='inline-flex items-center gap-2 text-[14px] text-neutral-400 transition-colors hover:text-neutral-900'>
      <span aria-hidden='true'>←</span> All games
    </a>

    <header class='mt-10 flex flex-col items-center text-center'>
      <Logo class='size-20' />
      <h1 class='font-display mt-6 text-[38px] leading-[1.08] text-balance sm:text-[50px]'>Make your own game</h1>
      <p class='mt-4 max-w-sm text-[16px] leading-relaxed text-pretty text-neutral-500 sm:text-[17px]'>
        Describe a game to Claude Code. It builds it in our style and sends it in.
      </p>
    </header>

    <ol class='mt-12 flex flex-col gap-4'>
      {
        steps.map((step, i) => (
          <li class='relative rounded-2xl bg-white p-5 shadow-[0_0_0_1px_rgba(0,0,0,.06),0_2px_8px_rgba(0,0,0,.04)] sm:p-6'>
            <div class='flex items-center gap-3'>
              <span class='font-display grid size-7 shrink-0 place-items-center rounded-full bg-butter text-[15px] text-umber shadow-[0_0_0_1px_rgba(180,83,9,.18)]'>
                {i + 1}
              </span>
              <h2 class='font-display text-[20px] leading-tight'>{step.title}</h2>
            </div>
            <div class='mt-3 text-[15px] leading-relaxed text-neutral-600'>
              {step.text}
              {step.code && (
                <div class='mt-3 flex items-start gap-2 rounded-xl bg-[#f5f5f4] py-2.5 pr-2 pl-4 shadow-[0_0_0_1px_rgba(0,0,0,.04)]'>
                  <pre class='min-w-0 flex-1 py-0.5 font-mono text-[13px] leading-relaxed whitespace-pre-wrap text-neutral-800 [overflow-wrap:anywhere]'>{step.code}</pre>
                  <button
                    type='button'
                    data-copy={step.code}
                    class='shrink-0 rounded-md px-2 py-1 font-mono text-[11px] text-neutral-400 transition-colors hover:bg-white hover:text-neutral-900'
                  >
                    copy
                  </button>
                </div>
              )}
              {step.terminal && (
                <div class='mt-4 grid grid-cols-3 gap-2 sm:grid-cols-6' role='group' aria-label='Figure style'>
                  {FIGURES.map((f, j) => (
                    <button
                      type='button'
                      data-figure={f.prompt}
                      aria-pressed={j === 0 ? 'true' : 'false'}
                      class='flex flex-col items-center rounded-xl bg-[#f5f5f4] px-1 pt-1 pb-2 shadow-[0_0_0_1px_rgba(0,0,0,.04)] transition-colors hover:bg-[#ececec] aria-pressed:bg-butter aria-pressed:shadow-[0_0_0_1px_rgba(180,83,9,.2)]'
                    >
                      <img src={`/figures/${f.id}.webp`} alt='' width='200' height='170' class='w-full' loading='lazy' />
                      <span class='font-display text-[14px] leading-tight text-neutral-800'>{f.name}</span>
                    </button>
                  ))}
                </div>
              )}
              {step.terminal && (
                <div class='mt-3 overflow-hidden rounded-xl bg-[#1f2329] shadow-[0_0_0_1px_rgba(0,0,0,.08),0_8px_24px_-12px_rgba(0,0,0,.35)]'>
                  <div class='flex items-center gap-1.5 px-3.5 py-2.5'>
                    <span class='size-2.5 rounded-full bg-[#ff5f57]' />
                    <span class='size-2.5 rounded-full bg-[#febc2e]' />
                    <span class='size-2.5 rounded-full bg-[#28c840]' />
                    <span class='ml-2 font-mono text-[11px] text-neutral-500'>goofyfish</span>
                  </div>
                  <div class='px-4 pt-1 pb-4 font-mono text-[13px] leading-relaxed'>
                    <div class='text-neutral-500'>
                      <span class='text-neutral-400'>$</span> claude
                    </div>
                    <div class='mt-3 flex gap-2 rounded-lg border border-neutral-600/70 px-3 py-2 text-neutral-100'>
                      <span class='text-neutral-500'>&gt;</span>
                      <span>
                        <span class='text-butter'>/game</span> {PROMPT}<span data-figure-text />
                        <span class='animate-blink ml-0.5 inline-block h-[1.05em] w-[0.55em] translate-y-[0.2em] bg-butter' />
                      </span>
                    </div>
                  </div>
                </div>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </main>

  <script is:inline>
    const figureText = document.querySelector('[data-figure-text]');
    for (const button of document.querySelectorAll('[data-figure]')) {
      button.addEventListener('click', () => {
        for (const other of document.querySelectorAll('[data-figure]')) {
          other.setAttribute('aria-pressed', String(other === button));
        }
        figureText.textContent = button.dataset.figure;
      });
    }
    for (const button of document.querySelectorAll('[data-copy]')) {
      button.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(button.dataset.copy);
          button.textContent = 'copied';
          setTimeout(() => {
            button.textContent = 'copy';
          }, 1500);
        } catch {}
      });
    }
  </script>
</Base>
