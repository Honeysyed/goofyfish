---
import Logo from '~/components/Logo.astro';
import Base from '~/layouts/Base.astro';
import { SITE } from '~/lib/site';
---

<Base
  title={`Nothing swims here · ${SITE.name}`}
  description="That page doesn't exist."
  path='/404'
  noindex
>
  <main class='mx-auto flex min-h-dvh max-w-md flex-col items-center justify-center px-6 text-center'>
    <Logo class='size-24 rotate-12' />
    <h1 class='font-display mt-6 text-3xl'>Nothing swims here</h1>
    <p class='mt-2 text-neutral-500'>That page doesn't exist, or it got eaten by a bigger fish.</p>
    <a
      href='/'
      class='font-display mt-8 inline-flex h-11 items-center rounded-xl bg-butter px-5 text-umber shadow-[0_0_0_1px_rgba(180,83,9,.2),0_2px_8px_rgba(0,0,0,.04)] transition-colors hover:bg-butter-hi'
    >
      Back to the games
    </a>
  </main>
</Base>
